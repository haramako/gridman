{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "composite": true
  },
  "include": ["vite.config.ts", "server/**/*.ts", "tailwind.config.ts"]
}
